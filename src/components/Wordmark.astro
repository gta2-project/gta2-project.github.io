---
import { Image } from 'astro:assets';
import gta2Logo from '../assets/gta2-logo.png';

interface Props {
	compact?: boolean;
}

const { compact = false } = Astro.props;
---

<span class:list={['wordmark', { 'wordmark--compact': compact }]} role="img" aria-label="Grounded Task Axes 2">
	<Image src={gta2Logo} alt="" width={1536} height={1024} loading="eager" />
</span>

<style>
	.wordmark {
		position: relative;
		display: block;
		width: 100%;
		isolation: isolate;
	}

	.wordmark :global(img) {
		display: block;
		width: 100%;
		height: auto;
	}

	.wordmark--compact {
		width: 5.2rem;
	}

</style>
